---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allQuestions = await getCollection('cauhoi');
const allPassages = await getCollection('baidoc');
const allLessons = await getCollection('nguphap');
const soCauIelts = allQuestions.filter(q => q.data.de_thi === 'ielts').length;
const soCauToeic = allQuestions.filter(q => q.data.de_thi === 'toeic').length;
const soCauReading = allQuestions.filter(q => q.data.ky_nang === 'reading').length;
const soCauListening = allQuestions.filter(q => q.data.ky_nang === 'listening').length;
const soBaiDoc = allPassages.length;
const soBaiHocNguPhap = allLessons.length;
---
<Layout title="Luyện thi IELTS · TOEIC — Học mỗi ngày, có thưởng">
  <section style="padding: 20px 0 8px;">
    <h1 style="font-size: 2.1rem; max-width: 14ch;">Học mỗi ngày một chút, giữ chuỗi streak, lên điểm dần.</h1>
    <p style="color: var(--ink-soft); font-size: 1.05rem; max-width: 52ch;">
      Làm bài thi thử IELTS &amp; TOEIC ngắn mỗi ngày. Mỗi câu đúng cộng điểm thưởng (XP),
      mỗi ngày học liên tục giữ chuỗi (streak) — giống cách Duolingo tạo động lực học ngoại ngữ.
    </p>

    <div class="select-card">
      <h3 style="margin: 0 0 4px;">Luyện tập nhanh (câu hỏi rời rạc)</h3>
      <p style="color: var(--ink-soft); font-size: .88rem; margin: 0 0 16px;">
        Từng câu độc lập, không gắn đoạn văn — phù hợp luyện từ vựng/ngữ pháp nhanh (ví dụ TOEIC Part 5).
        Muốn học một chủ điểm ngữ pháp bài bản, dùng mục "Ngữ pháp" bên dưới. Muốn bài đọc dài đúng chuẩn thi thật, dùng mục "Luyện đọc hiểu".
      </p>
      <div class="select-row">
        <label for="sel-de">Đề thi</label>
        <select id="sel-de">
          <option value="all">Tất cả</option>
          <option value="ielts">IELTS</option>
          <option value="toeic">TOEIC</option>
        </select>
      </div>
      <div class="select-row">
        <label for="sel-ky">Kỹ năng</label>
        <select id="sel-ky">
          <option value="all">Tất cả</option>
          <option value="reading">Reading</option>
          <option value="listening">Listening</option>
        </select>
      </div>
      <div class="select-row">
        <label>Chế độ</label>
        <div class="mode-toggle">
          <button type="button" class="mode-btn active" data-mode="quick">Luyện tập nhanh · 8 câu</button>
          <button type="button" class="mode-btn" data-mode="mock">Mock Test · 20 câu</button>
        </div>
      </div>
      <button class="btn-primary" id="btn-start" style="width: 100%; margin-top: 4px;">Bắt đầu làm bài</button>
    </div>

    <p style="margin-top: 28px; color: var(--ink-soft); font-size: 0.9rem;">
      Ngân hàng câu hỏi hiện có: {soCauIelts} câu IELTS · {soCauToeic} câu TOEIC
      &nbsp;—&nbsp; {soCauReading} Reading · {soCauListening} Listening.
      Đây là bản MVP — số lượng câu hỏi sẽ tăng dần qua CMS quản trị.
    </p>

    <div class="select-card" style="margin-top: 20px;">
      <h3 style="margin: 0 0 4px;">Ngữ pháp</h3>
      <p style="color: var(--ink-soft); font-size: .88rem; margin: 0 0 16px;">
        Học quy tắc từng chủ điểm trước, rồi làm bài tập luyện bám sát đúng chủ điểm đó.
        Hiện có {soBaiHocNguPhap} chủ điểm.
      </p>
      <a href="/ngu-phap"><button class="btn-primary" style="width: 100%;">Xem các chủ điểm</button></a>
    </div>

    <div class="select-card" style="margin-top: 20px;">
      <h3 style="margin: 0 0 4px;">Luyện đọc hiểu (Reading Passage)</h3>
      <p style="color: var(--ink-soft); font-size: .88rem; margin: 0 0 16px;">
        Đọc một đoạn văn dài, trả lời bộ câu hỏi gắn theo đúng đoạn đó — đúng cấu trúc IELTS Reading thật,
        thay vì các câu hỏi rời rạc. Hiện có {soBaiDoc} bài đọc.
      </p>
      <div class="select-row">
        <label for="sel-de-doc">Đề thi</label>
        <select id="sel-de-doc">
          <option value="all">Tất cả</option>
          <option value="ielts">IELTS</option>
          <option value="toeic">TOEIC</option>
        </select>
      </div>
      <button class="btn-primary" id="btn-start-doc" style="width: 100%; margin-top: 4px;">Đọc và trả lời</button>
    </div>
  </section>

  <style is:global>
    .select-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 22px; margin-top: 24px; max-width: 420px;
    }
    .select-row { margin-bottom: 16px; }
    .select-row label { display: block; font-size: .85rem; font-weight: 600; color: var(--ink-soft); margin-bottom: 6px; }
    .select-row select {
      width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius);
      font-family: inherit; font-size: .95rem; background: white; color: var(--ink);
    }
    .mode-toggle { display: flex; gap: 8px; }
    .mode-btn {
      flex: 1; padding: 10px 8px; border: 1px solid var(--border); border-radius: var(--radius);
      background: white; color: var(--ink-soft); font-size: .85rem; font-weight: 600; cursor: pointer;
    }
    .mode-btn.active { border-color: var(--ink); background: var(--ink); color: white; }
  </style>

  <script>
    let mode = 'quick';
    document.querySelectorAll('.mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.mode;
        document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    document.getElementById('btn-start').addEventListener('click', () => {
      const de = document.getElementById('sel-de').value;
      const ky = document.getElementById('sel-ky').value;
      window.location.href = `/quiz?de=${de}&ky=${ky}&mode=${mode}`;
    });

    document.getElementById('btn-start-doc').addEventListener('click', () => {
      const de = document.getElementById('sel-de-doc').value;
      window.location.href = `/doc-hieu?de=${de}`;
    });
  </script>
</Layout>
